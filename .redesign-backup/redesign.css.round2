/* Bagger Finder redesign: "Site Yellow" theme + compact layout.
   Loaded after globals.css (see app/layout.tsx) and only overrides looks, never behaviour. */

:root {
  --bg: #f5f4f0;
  --panel: #fff;
  --ink: #17181a;
  --muted: #5f6670;
  --line: #e4e2dc;
  --accent: #f2b200;          /* safety yellow: buttons, active chips, selected pin */
  --accent-hover: #dca200;
  --accent-ink: #17181a;      /* text on yellow */
  --accent-strong: #6b4a00;   /* yellow-family text on light backgrounds */
  --accent-soft: #fff5d1;
  --accent-line: #ebcf7a;
  --pick: #fffae8;            /* selected card */
  --pin: #2a2d31;             /* graphite: normal map pins, header band */
  --good: #047857;
  --good-soft: #e3f4ec;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #121417;
    --panel: #1a1d21;
    --ink: #e8eaed;
    --muted: #9aa3ad;
    --line: #2c3036;
    --accent-strong: #f7d768;
    --accent-soft: #3a3118;
    --accent-line: #5c4c1d;
    --pick: #262316;
    --pin: #3b4047;
    --good: #34d399;
    --good-soft: #123326;
  }
}

/* ---------- header ---------- */
.top { flex-wrap: wrap; gap: 10px 20px; padding: 8px 20px; border-top: 4px solid var(--pin); position: relative; z-index: 1100; }
.brand { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 auto; }
.brand h1 { font-size: 18px; letter-spacing: -0.01em; white-space: nowrap; }
.brand .sub { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.logo { flex: none; width: 32px; height: 32px; border-radius: 8px; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; }

.seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 9px; background: var(--bg); border: 1px solid var(--line); }
.seg button { height: 30px; padding: 0 14px; border: 0; border-radius: 7px; background: transparent; color: var(--muted); font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; }
.seg button:hover { color: var(--ink); }
.seg button.on { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgb(0 0 0 / 0.14); }

.top-actions { position: relative; gap: 8px; }
.next-scrape { width: 160px; margin-right: 4px; }
.next-scrape progress { height: 4px; }

/* ---------- buttons ---------- */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; padding: 0 14px; white-space: nowrap; font: inherit; font-weight: 600; }
.btn:hover:not(:disabled) { background: var(--accent-hover); }
.btn.secondary { background: var(--panel); color: var(--ink); border: 1px solid var(--line); font-weight: 500; }
.btn.secondary:hover:not(:disabled) { background: var(--bg); }
.btn.secondary.on { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent-strong); }
.btn.icon { width: 36px; padding: 0; }
.btn.ghost { background: transparent; color: var(--muted); border: 0; font-weight: 500; }
.btn.ghost:hover:not(:disabled) { background: var(--bg); color: var(--ink); }
.badge { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px; background: var(--accent); color: var(--accent-ink); font-size: 12px; font-weight: 700; display: inline-grid; place-items: center; }

/* ---------- inputs ---------- */
input:not([type="checkbox"]), select { height: 36px; padding: 0 10px; background: var(--panel); }
input:focus-visible, select:focus-visible { outline: 2px solid var(--accent-line); outline-offset: 0; border-color: var(--accent-strong); }
.field-label { display: grid; gap: 4px; font-size: 12px; font-weight: 500; color: var(--muted); }
.field-label input, .field-label select { width: 100%; color: var(--ink); font-weight: 400; }

/* ---------- scraper settings popover ---------- */
.popover {
  position: absolute; top: calc(100% + 8px); right: 0; z-index: 1200;
  width: 340px; max-width: calc(100vw - 32px); padding: 16px;
  display: grid; gap: 14px;
  background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
  box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
}
.popover-head { display: flex; align-items: center; justify-content: space-between; font-size: 15px; }
.popover-head .btn { width: 30px; height: 30px; }
.popover.settings label { font-weight: 500; }
.popover.settings .field-label { font-weight: 500; }
.popover.settings select { width: 100%; margin: 0; padding: 0 10px; }
.check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
.check input { flex: none; width: 18px; height: 18px; margin: 1px 0 0; padding: 0; accent-color: var(--accent); }
.check > span { display: grid; gap: 2px; }
.check-title { font-size: 14px; color: var(--ink); }

/* ---------- left panel ---------- */
.split { grid-template-columns: minmax(360px, 480px) 1fr; }
.controls { padding: 12px 16px; gap: 10px; }
.search { position: relative; flex: 1; min-width: 0; display: flex; }
.search svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
.search input { padding-left: 34px; }
.filters-btn { flex: none; }

.filter-panel { display: grid; gap: 14px; padding-top: 2px; }
.filter-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; }
.group-label { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 500; color: var(--muted); }
.filter-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; }

.chip { height: 30px; padding: 0 11px; font-size: 13px; background: var(--panel); }
.chip:hover { background: var(--bg); }
.chip.on { font-weight: 600; }
.chip.on:hover { background: var(--accent-hover); }
.chip.deal.on:hover { background: #036a4c; }
.active-chips { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: thin; }
.chip.active { flex: none; display: inline-flex; align-items: center; gap: 6px; background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent-strong); font-weight: 500; }

.list-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 16px; border-bottom: 1px solid var(--line); background: var(--bg); font-size: 13px; color: var(--muted); }
.list-head strong { color: var(--ink); }
.list-head label { display: flex; align-items: center; gap: 6px; }
.list-head select { flex: none; width: auto; height: 30px; padding: 0 6px; font-size: 13px; }

/* ---------- listing cards ---------- */
.card { flex-direction: column; flex-wrap: nowrap; gap: 8px; padding: 12px 16px; background: var(--panel); }
.card:hover { background: color-mix(in srgb, var(--accent) 5%, var(--panel)); }
.card.sel { background: var(--pick); box-shadow: inset 0 0 0 1px var(--accent-line); }
.card-main { display: flex; gap: 12px; min-width: 0; }
.card img, .thumb { width: 76px; height: 60px; border-radius: 8px; flex: none; }
.thumb { display: grid; place-items: center; background: var(--bg); color: var(--muted); }
.title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; min-width: 0; }
.title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; }
.title:hover { color: var(--accent-strong); }
.price { flex: none; font-size: 15px; font-variant-numeric: tabular-nums; }
.facts { display: block; margin-top: 2px; font-size: 13px; color: var(--muted); }
.body p.deal-why { margin-top: 4px; font-size: 12.5px; font-weight: 500; color: var(--ink); }
.body p.desc { -webkit-line-clamp: 1; }
.tags { margin: 6px 0 0; gap: 6px; align-items: center; }
.tag { padding: 1px 7px; border: 0; border-radius: 5px; font-size: 11.5px; font-weight: 500; background: var(--bg); color: var(--muted); }
.tag.model { color: var(--ink); }
.tag.wheel { color: var(--good); background: var(--good-soft); }
.tag.source { background: transparent; padding: 0; font-weight: 400; }
.tag.warn { color: var(--sel); background: color-mix(in srgb, var(--sel) 10%, var(--panel)); }
.tag.deal { color: #92400e; background: #fdf0dc; }
.tag.deal.interesting { color: #fff; background: #047857; }
.tag.deal.suspicious { color: #b91c1c; background: #fde8e8; }

/* Pakistan cost: one slim row, details on click */
.card .cost { padding: 6px 10px; border-radius: 8px; background: var(--accent-soft); }
.cost summary { display: flex; align-items: center; justify-content: space-between; gap: 4px 12px; flex-wrap: wrap; }
.cost-head { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--accent-strong); }
.cost-head::after { font-size: 12px; }
.cost-totals { gap: 0 10px; justify-content: flex-end; font-size: 13px; }
.cost-totals strong + strong { font-weight: 500; color: var(--muted); }

/* ---------- map ---------- */
.pin { background: var(--pin); color: #fff; padding: 2px 8px; font: 600 12px system-ui, sans-serif; }
.pin.sel { background: var(--accent); color: var(--accent-ink); }
.popup a { color: #17181a; }
.popup a:hover { color: #6b4a00; }
.popup .cost { background: #fff5d1; }
.popup .cost-head { color: #6b4a00; }

/* ---------- view modes ---------- */
.split.view-list, .split.view-map { grid-template-columns: 1fr; }
.view-list .left { border-right: 0; }
.view-list .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); align-content: start; }
.view-list .card { border-right: 1px solid var(--line); }

@media (max-width: 800px) {
  .top { padding: 8px 12px; }
  .brand .sub { display: none; }
  .split.view-list, .split.view-map { grid-template-rows: 1fr; }
  .filter-grid { grid-template-columns: 1fr 1fr; }
  .filter-grid .field-label:first-child { grid-column: 1 / -1; }
  .view-list .list { grid-template-columns: 1fr; }
}
