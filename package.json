{
  "name": "bagger-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Finds used excavators, wheel loaders, graders and rollers on European marketplaces and shows them on a map.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "scrape": "tsx scraper/run.ts",
    "market-report": "node --env-file=.env --import tsx scraper/market-report.ts",
    "knowledge": "node --env-file=.env --import tsx scraper/knowledge.ts",
    "try-source": "tsx scraper/try-source.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:live": "tsx tests/live-parity.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@workos-inc/authkit-nextjs": "^4.6.3",
    "@workos-inc/node": "^12.2.0",
    "crawlee": "^3.11.0",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "playwright": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
