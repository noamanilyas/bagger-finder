# Needed for AI extraction of listings (optional; a basic heuristic parser is used without it)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5

# Scrape automatically 30s after start and then every 6 hours (set to false to disable)
AUTO_SCRAPE=true

# Where listings.json / status.json / geocode cache are stored (default ./data)
# DATA_DIR=./data
