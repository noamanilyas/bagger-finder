# Free key from https://openrouter.ai/keys — used to extract listing data with free models.
# Optional: without it a basic heuristic parser is used.
OPENROUTER_API_KEY=
# AI providers, used together. A busy or exhausted one rests and the next takes over:
# Gemini, then Groq, then free OpenRouter models, then the regex parser. All are optional.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b


# Comma-separated OpenRouter model ids tried first; other free models are discovered automatically
EXTRACT_MODELS=google/gemma-4-31b-it:free

# Scrape automatically. How often is set under "Scraper settings" in the app; the next scrape is due one
# interval after the last one started (recorded in Supabase), and a missed one runs at startup.
# Set AUTO_SCRAPE=false to disable (e.g. while developing); "Refresh now" still works.
AUTO_SCRAPE=true

# Supabase (listings are stored here). Run supabase/schema.sql once in the SQL editor.
# Only the secret key is used, server-side. Never commit the real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sign-in with WorkOS (dashboard.workos.com). Leave WORKOS_CLIENT_ID empty for local use without sign-in;
# production refuses every request without it.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# At least 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Comma-separated addresses allowed to use the site. Empty lets nobody in.
ALLOWED_EMAILS=

# Key for POST /api/ingest, where an external system sends machines to store (see README). At least 16 characters:
# openssl rand -hex 32. Empty turns the API off.
INGEST_API_KEY=

# mobile.de Search-API, once mobile.de's customer support has activated an API-Account. Without these mobile.de is skipped.
MOBILE_DE_API_USER=
MOBILE_DE_API_PASSWORD=

# Force every page through headless Chromium (needs more RAM than Render's free plan)
# USE_BROWSER=false

# Where listings.json / status.json / geocode cache are stored (default ./data)
# DATA_DIR=./data

# Optional, only for admin tasks like creating tables from the command line (Supabase > Connect > Direct connection,
# with the password URL-encoded). The app itself does not use it. Never commit the real value.
DATABASE_URL=
